# Root backend configuration. Do not commit .env or real secrets.
APP_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
# Local demo needs no cloud database.
PERSISTENCE_BACKEND=sqlite
# For existing Neon accounts, set postgres and paste the real SSL URL privately.
DATABASE_URL=
# Optional: development persists a generated secret if empty; production requires >=32 chars.
JWT_SECRET_KEY=
# Optional generation. Numerical ML and local retrieval work without this key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional absolute paths: DATASET_PATH, MODEL_DIR, RUNTIME_DIR
